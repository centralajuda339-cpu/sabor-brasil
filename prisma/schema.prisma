// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Cliente {
  id          String    @id @default(cuid())
  nome        String
  telefone    String    @unique
  senhaHash   String
  dataRegisto DateTime  @default(now())
  reservas    Reserva[]
}

model Zona {
  id       String    @id @default(cuid())
  nome     String    @unique
  mesas    Mesa[]
  reservas Reserva[]
}

model Mesa {
  id         String    @id @default(cuid())
  zonaId     String
  zona       Zona      @relation(fields: [zonaId], references: [id])
  capacidade Int
  tipo       String
  reservas   Reserva[]
}

model Staff {
  id        String    @id @default(cuid())
  nome      String
  telefone  String    @unique
  senhaHash String
  perfil    String // "STAFF" ou "GESTOR"
  ativo     Boolean   @default(true)
  reservas  Reserva[]
}

model Configuracao {
  id                String @id @default("geral")
  taxaPorPessoa     Float  @default(500)
  percentagemMinima Float  @default(30)
}

model Reserva {
  id        String     @id @default(cuid())
  clienteId String
  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  zonaId    String
  zona      Zona       @relation(fields: [zonaId], references: [id])
  mesaId    String?
  mesa      Mesa?      @relation(fields: [mesaId], references: [id])
  staffId   String?
  staff     Staff?     @relation(fields: [staffId], references: [id])
  nPessoas  Int
  dataHora  DateTime
  duracao   Int        @default(120)
  estado    String     @default("PENDENTE")
  pagamento Pagamento?
  criadaEm  DateTime   @default(now())
}

model Pagamento {
  id         String  @id @default(cuid())
  reservaId  String  @unique
  reserva    Reserva @relation(fields: [reservaId], references: [id])
  tipo       String
  valorPago  Float
  valorTotal Float
  referencia String
  estado     String
}

model CategoriaCardapio {
  id             String              @id @default(cuid())
  nome           String
  categoriaPaiId String?
  categoriaPai   CategoriaCardapio?  @relation("Subcategorias", fields: [categoriaPaiId], references: [id])
  subcategorias  CategoriaCardapio[] @relation("Subcategorias")
  itens          ItemCardapio[]
}

model ItemCardapio {
  id          String            @id @default(cuid())
  categoriaId String
  categoria   CategoriaCardapio @relation(fields: [categoriaId], references: [id])
  nome        String
  descricao   String?
  preco       Float
}